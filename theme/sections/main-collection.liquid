<section class="collection page-width">
  <div class="collection__header">
    <h1 class="collection__title">{{ collection.title | escape }}</h1>
    {%- if section.settings.subline != blank -%}
      <p class="collection__subline">{{ section.settings.subline | escape }}</p>
    {%- elsif collection.description != blank -%}
      <p class="collection__subline">{{ collection.description | strip_html | truncate: 160 }}</p>
    {%- endif -%}
  </div>

  <div class="collection__filters">
    <div class="collection__filter-chips">
      <span class="collection__filter-label">Filter:</span>
      <button class="collection__filter-chip" type="button">Skin Concern</button>
      <button class="collection__filter-chip" type="button">Product Type</button>
      <button class="collection__filter-chip" type="button">Brand</button>
    </div>
    <div class="collection__sort">
      <label for="CollectionSort" class="visually-hidden">Sort by</label>
      <select id="CollectionSort" class="collection__sort-select">
        <option value="featured">Sort: Featured</option>
        <option value="best-selling">Best Selling</option>
        <option value="price-ascending">Price: Low to High</option>
        <option value="price-descending">Price: High to Low</option>
        <option value="newest">Newest</option>
      </select>
    </div>
  </div>

  {% paginate collection.products by 12 %}
    {%- if collection.products.size > 0 -%}
      <ul class="product-grid" role="list">
        {%- for product in collection.products -%}
          <li>{% render 'product-card', product: product %}</li>
        {%- endfor -%}
      </ul>
      <div class="collection__pagination">{{ paginate | default_pagination }}</div>
    {%- else -%}
      <p class="collection__empty">{{ section.settings.no_results_subline | default: 'collections.empty' | t }}</p>
    {%- endif -%}
  {% endpaginate %}
</section>

{% schema %}
{
  "name": "Collection",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "text",
      "id": "subline",
      "label": "Subline",
      "default": "Curated formulas for face, body, and mind. Minimal ingredients. Maximum intention."
    },
    {
      "type": "text",
      "id": "no_results_subline",
      "label": "No results text"
    }
  ],
  "presets": [
    {
      "name": "Collection"
    }
  ]
}
{% endschema %}
