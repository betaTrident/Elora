<section class="featured-collection page-width">
  {%- if section.settings.title != blank -%}
    <h2 class="featured-collection__title reveal">{{ section.settings.title | escape }}</h2>
  {%- endif -%}

  {%- liquid
    assign featured = section.settings.collection
    if featured == blank
      assign featured = collections['skincare-essentials']
    endif
    if featured == blank or featured.products.size == 0
      assign featured = collections['all']
    endif
  -%}

  {%- if featured != blank and featured.products.size > 0 -%}
    <ul class="product-grid" role="list">
      {%- for product in featured.products limit: section.settings.products_to_show -%}
        <li>{% render 'product-card', product: product %}</li>
      {%- endfor -%}
    </ul>
    {%- if featured.url != blank -%}
      <div class="featured-collection__footer reveal">
        <a href="{{ featured.url }}" class="btn btn--secondary">{{ 'featured_collection.view_all' | t: title: featured.title }}</a>
      </div>
    {%- endif -%}
  {%- else -%}
    {%- assign lineup_handles = 'nourishing-cleanser,daily-hydration-gel,glow-drops-serum,airy-sun-fluid-spf-50,restorative-night-cream,balancing-toner,body-lotion,body-oil,eau-de-parfum' | split: ',' -%}
    <ul class="product-grid featured-collection__lineup" role="list">
      {%- for lineup_handle in lineup_handles -%}
        {%- assign handle_key = lineup_handle | replace: '-', '_' -%}
        {%- assign title_key = 'lineup.' | append: handle_key | append: '.title' -%}
        {%- assign price_key = 'lineup.' | append: handle_key | append: '.price' -%}
        <li>
          <article class="product-card">
            <a href="{{ routes.root_url }}products/{{ lineup_handle }}" class="product-card__link">
              <div class="product-card__image-wrap">
                {%- render 'product-asset', handle: lineup_handle, class: 'product-card__image', loading: 'lazy' -%}
              </div>
              <div class="product-card__body">
                <h3 class="product-card__title">{{ title_key | t }}</h3>
                <p class="product-card__price">{{ price_key | t }}</p>
              </div>
            </a>
          </article>
        </li>
      {%- endfor -%}
    </ul>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Heading",
      "default": "The ritual wardrobe"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 9
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
