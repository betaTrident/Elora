<section class="about">
  <header class="about__hero page-width">
    <p class="about__eyebrow reveal">{{ 'about.eyebrow' | t }}</p>
    <h1 class="about__heading reveal">
      {%- if section.settings.heading != blank -%}
        {{ section.settings.heading | escape }}
      {%- else -%}
        {{ 'about.heading' | t }}
      {%- endif -%}
    </h1>
    <p class="about__lede reveal reveal-delay-1">
      {%- if section.settings.lede != blank -%}
        {{ section.settings.lede | escape }}
      {%- else -%}
        {{ 'about.lede' | t }}
      {%- endif -%}
    </p>
  </header>

  <article class="about__story page-width">
    <div class="about__story-copy reveal">
      <h2 class="about__story-heading">
        {%- if section.settings.story_heading != blank -%}
          {{ section.settings.story_heading | escape }}
        {%- else -%}
          {{ 'about.story_heading' | t }}
        {%- endif -%}
      </h2>
      <div class="about__story-body">
        {%- if section.settings.story_body != blank -%}
          {{ section.settings.story_body }}
        {%- else -%}
          <p>{{ 'about.story_body' | t }}</p>
        {%- endif -%}
      </div>
      {%- if page.content != blank -%}
        <div class="about__cms">{{ page.content }}</div>
      {%- endif -%}
    </div>
    {%- if section.settings.image != blank or section.settings.fallback_asset != blank -%}
      <div class="about__story-media reveal reveal-delay-1">
        {%- if section.settings.image != blank -%}
          {{ section.settings.image | image_url: width: 1400 | image_tag: class: 'about__story-img', loading: 'lazy', alt: section.settings.image.alt }}
        {%- else -%}
          <img
            src="{{ section.settings.fallback_asset | asset_url }}"
            class="about__story-img"
            loading="lazy"
            alt=""
            width="800"
            height="1000"
          >
        {%- endif -%}
      </div>
    {%- endif -%}
  </article>

  <div class="about__values">
    <ol class="about__value-list page-width" role="list">
      <li class="about__value reveal">
        <span class="about__value-index" aria-hidden="true">01</span>
        <h3 class="about__value-title">{{ 'about.value_one_title' | t }}</h3>
        <p class="about__value-body">{{ 'about.value_one_body' | t }}</p>
      </li>
      <li class="about__value reveal reveal-delay-1">
        <span class="about__value-index" aria-hidden="true">02</span>
        <h3 class="about__value-title">{{ 'about.value_two_title' | t }}</h3>
        <p class="about__value-body">{{ 'about.value_two_body' | t }}</p>
      </li>
      <li class="about__value reveal reveal-delay-2">
        <span class="about__value-index" aria-hidden="true">03</span>
        <h3 class="about__value-title">{{ 'about.value_three_title' | t }}</h3>
        <p class="about__value-body">{{ 'about.value_three_body' | t }}</p>
      </li>
    </ol>
  </div>

  <div class="about__close page-width reveal">
    <h2 class="about__close-heading">{{ 'about.close_heading' | t }}</h2>
    <p class="about__close-body">{{ 'about.close_body' | t }}</p>
    <div class="about__actions">
      <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'about.cta_shop' | t }}</a>
      <a href="{{ routes.root_url }}#ritual" class="btn btn--secondary">{{ 'about.cta_ritual' | t }}</a>
    </div>
  </div>
</section>

{% stylesheet %}
  .about {
    padding: var(--spacing-2xl) 0 var(--spacing-section);
  }

  .about__hero {
    max-width: 40rem;
    margin-bottom: var(--spacing-2xl);
  }

  .about__eyebrow {
    margin: 0 0 var(--spacing-md);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-muted);
  }

  .about__heading {
    margin: 0 0 var(--spacing-md);
    font-size: clamp(2.1rem, 5vw, 3.35rem);
    font-style: italic;
    letter-spacing: -0.03em;
    line-height: 1.08;
  }

  .about__lede {
    margin: 0;
    max-width: 42ch;
    color: var(--color-muted);
    font-size: 1.0625rem;
    line-height: 1.7;
  }

  .about__story {
    display: grid;
    gap: var(--spacing-xl);
    align-items: center;
    margin-bottom: var(--spacing-section);
  }

  @media (min-width: 768px) {
    .about__story {
      grid-template-columns: 1fr 1fr;
      gap: var(--spacing-2xl);
    }
  }

  .about__story-heading {
    margin: 0 0 var(--spacing-md);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-style: italic;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .about__story-body,
  .about__cms {
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.75;
    max-width: 44ch;
  }

  .about__story-body p,
  .about__cms p {
    margin: 0 0 1em;
  }

  .about__story-body p:last-child,
  .about__cms p:last-child {
    margin-bottom: 0;
  }

  .about__cms {
    margin-top: var(--spacing-md);
  }

  .about__story-media {
    overflow: hidden;
  }

  .about__story-img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center;
    background: var(--color-sand);
    display: block;
  }

  .about__values {
    padding: var(--spacing-xl) 0;
    margin-bottom: var(--spacing-section);
    border-top: 1px solid var(--color-sand);
    border-bottom: 1px solid var(--color-sand);
  }

  .about__value-list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--spacing-xl);
  }

  @media (min-width: 768px) {
    .about__value-list {
      grid-template-columns: repeat(3, 1fr);
      gap: var(--spacing-2xl);
    }
  }

  .about__value-index {
    display: block;
    margin-bottom: 0.65rem;
    font-size: 0.75rem;
    letter-spacing: 0.12em;
    color: var(--color-sage);
  }

  .about__value-title {
    margin: 0 0 var(--spacing-sm);
    font-family: var(--font-body);
    font-size: 1rem;
    font-weight: 500;
    letter-spacing: 0.01em;
    line-height: 1.3;
  }

  .about__value-body {
    margin: 0;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.65;
    max-width: 32ch;
  }

  .about__close {
    text-align: center;
  }

  .about__close-heading {
    margin: 0 0 var(--spacing-sm);
    font-size: clamp(1.6rem, 3vw, 2.25rem);
    font-style: italic;
    letter-spacing: -0.02em;
    line-height: 1.15;
  }

  .about__close-body {
    margin: 0 auto var(--spacing-lg);
    max-width: 36ch;
    color: var(--color-muted);
    font-size: 0.9375rem;
    line-height: 1.7;
  }

  .about__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "About",
  "enabled_on": {
    "templates": ["page"]
  },
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to use the theme translation."
    },
    {
      "type": "textarea",
      "id": "lede",
      "label": "Lede"
    },
    {
      "type": "text",
      "id": "story_heading",
      "label": "Story heading"
    },
    {
      "type": "richtext",
      "id": "story_body",
      "label": "Story body"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story image"
    },
    {
      "type": "text",
      "id": "fallback_asset",
      "label": "Fallback asset filename",
      "info": "Theme asset filename, e.g. lp-asset1.png",
      "default": "lp-asset1.png"
    }
  ],
  "presets": [
    {
      "name": "About"
    }
  ]
}
{% endschema %}
