<section class="utility-page page-width customers-page">
  {%- case request.page_type -%}
    {%- when 'customers/login' -%}
      <h1 class="utility-page__title">{{ 'customers.login' | t }}</h1>
      {% form 'customer_login', class: 'customers-form' %}
        {{ form.errors | default_errors }}
        <label for="CustomerEmail">{{ 'customers.email' | t }}</label>
        <input id="CustomerEmail" type="email" name="customer[email]" autocomplete="email" required>
        <label for="CustomerPassword">{{ 'customers.password' | t }}</label>
        <input id="CustomerPassword" type="password" name="customer[password]" autocomplete="current-password" required>
        <button type="submit" class="btn btn--full">{{ 'customers.submit_login' | t }}</button>
      {% endform %}
      <p>
        <a href="#recover">{{ 'customers.forgot' | t }}</a>
        ·
        <a href="{{ routes.account_register_url }}">{{ 'customers.register' | t }}</a>
      </p>
      <div id="recover">
        <h2 class="customers-page__subhead">{{ 'customers.recover' | t }}</h2>
        <p class="utility-page__lede">{{ 'customers.recover_prompt' | t }}</p>
        {% form 'recover_customer_password', class: 'customers-form' %}
          {{ form.errors | default_errors }}
          <label for="RecoverEmail">{{ 'customers.email' | t }}</label>
          <input id="RecoverEmail" type="email" name="email" autocomplete="email" required>
          <button type="submit" class="btn btn--secondary btn--full">{{ 'customers.submit_recover' | t }}</button>
        {% endform %}
      </div>

    {%- when 'customers/register' -%}
      <h1 class="utility-page__title">{{ 'customers.register' | t }}</h1>
      {% form 'create_customer', class: 'customers-form' %}
        {{ form.errors | default_errors }}
        <label for="RegisterFirst">{{ 'customers.first_name' | t }}</label>
        <input id="RegisterFirst" type="text" name="customer[first_name]" autocomplete="given-name">
        <label for="RegisterLast">{{ 'customers.last_name' | t }}</label>
        <input id="RegisterLast" type="text" name="customer[last_name]" autocomplete="family-name">
        <label for="RegisterEmail">{{ 'customers.email' | t }}</label>
        <input id="RegisterEmail" type="email" name="customer[email]" autocomplete="email" required>
        <label for="RegisterPassword">{{ 'customers.password' | t }}</label>
        <input id="RegisterPassword" type="password" name="customer[password]" autocomplete="new-password" required>
        <button type="submit" class="btn btn--full">{{ 'customers.submit_register' | t }}</button>
      {% endform %}
      <p><a href="{{ routes.account_login_url }}">{{ 'customers.login' | t }}</a></p>

    {%- when 'customers/account' -%}
      <h1 class="utility-page__title">{{ 'customers.account' | t }}</h1>
      <p>
        <a href="{{ routes.account_addresses_url }}">{{ 'customers.addresses' | t }}</a>
        ·
        <a href="{{ routes.account_logout_url }}">{{ 'customers.logout' | t }}</a>
      </p>
      <h2 class="customers-page__subhead">{{ 'customers.orders' | t }}</h2>
      {%- if customer.orders.size > 0 -%}
        <ul class="customers-orders" role="list">
          {%- for order in customer.orders -%}
            <li>
              <a href="{{ order.customer_url }}">{{ order.name }}</a>
              <span>{{ order.created_at | date: '%B %d, %Y' }} · {{ order.total_price | money }}</span>
            </li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <p class="utility-page__empty">{{ 'customers.no_orders' | t }}</p>
      {%- endif -%}

    {%- when 'customers/addresses' -%}
      <h1 class="utility-page__title">{{ 'customers.addresses' | t }}</h1>
      <p><a href="{{ routes.account_url }}">{{ 'customers.account' | t }}</a></p>
      {%- for address in customer.addresses -%}
        <article class="customers-address">
          {{ address | format_address }}
          {%- if address == customer.default_address -%}
            <p>{{ 'customers.default_address' | t }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
      <h2 class="customers-page__subhead">{{ 'customers.add_address' | t }}</h2>
      {% form 'customer_address', customer.new_address, class: 'customers-form' %}
        {{ form.errors | default_errors }}
        <label for="AddressFirst">{{ 'customers.first_name' | t }}</label>
        <input id="AddressFirst" type="text" name="address[first_name]" autocomplete="given-name">
        <label for="AddressLast">{{ 'customers.last_name' | t }}</label>
        <input id="AddressLast" type="text" name="address[last_name]" autocomplete="family-name">
        <label for="Address1">{{ 'customers.address' | t }}</label>
        <input id="Address1" type="text" name="address[address1]" autocomplete="address-line1">
        <label for="AddressCity">{{ 'customers.city' | t }}</label>
        <input id="AddressCity" type="text" name="address[city]" autocomplete="address-level2">
        <label for="AddressZip">{{ 'customers.postal' | t }}</label>
        <input id="AddressZip" type="text" name="address[zip]" autocomplete="postal-code">
        <button type="submit" class="btn btn--full">{{ 'customers.add_address' | t }}</button>
      {% endform %}

    {%- when 'customers/order' -%}
      <h1 class="utility-page__title">{{ 'customers.order' | t: name: order.name }}</h1>
      <p><a href="{{ routes.account_url }}">{{ 'customers.account' | t }}</a></p>
      <ul class="customers-orders" role="list">
        {%- for line_item in order.line_items -%}
          <li>{{ line_item.title | escape }} × {{ line_item.quantity }} · {{ line_item.final_line_price | money }}</li>
        {%- endfor -%}
      </ul>
      <p>{{ order.total_price | money }}</p>

    {%- when 'customers/reset_password' -%}
      <h1 class="utility-page__title">{{ 'customers.reset' | t }}</h1>
      {% form 'reset_customer_password', class: 'customers-form' %}
        {{ form.errors | default_errors }}
        <label for="ResetPassword">{{ 'customers.password' | t }}</label>
        <input id="ResetPassword" type="password" name="customer[password]" required>
        <label for="ResetPasswordConfirm">{{ 'customers.password' | t }}</label>
        <input id="ResetPasswordConfirm" type="password" name="customer[password_confirmation]" required>
        <button type="submit" class="btn btn--full">{{ 'customers.submit_reset' | t }}</button>
      {% endform %}

    {%- when 'customers/activate_account' -%}
      <h1 class="utility-page__title">{{ 'customers.activate' | t }}</h1>
      {% form 'activate_customer_password', class: 'customers-form' %}
        {{ form.errors | default_errors }}
        <label for="ActivatePassword">{{ 'customers.password' | t }}</label>
        <input id="ActivatePassword" type="password" name="customer[password]" required>
        <label for="ActivatePasswordConfirm">{{ 'customers.password' | t }}</label>
        <input id="ActivatePasswordConfirm" type="password" name="customer[password_confirmation]" required>
        <button type="submit" class="btn btn--full">{{ 'customers.submit_activate' | t }}</button>
      {% endform %}
  {%- endcase -%}
</section>

{% schema %}
{
  "name": "Customers",
  "settings": []
}
{% endschema %}
