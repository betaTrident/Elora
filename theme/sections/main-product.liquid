<nav class="product__breadcrumb page-width" aria-label="Breadcrumb">
  <ol class="breadcrumb__list">
    <li><a href="{{ routes.root_url }}">Home</a></li>
    <li><a href="{{ routes.root_url }}products">Products</a></li>
    <li aria-current="page">{{ product.title | escape }}</li>
  </ol>
</nav>

<section class="product page-width">
  <div class="product__media-col">
    <div class="product__media">
      {%- if product.featured_image -%}
        <img
          id="ProductMainImage-{{ section.id }}"
          src="{{ product.featured_image | image_url: width: 1200 }}"
          alt="{{ product.featured_image.alt | escape }}"
          class="product__image"
          loading="eager"
          width="1200"
          height="{{ 1200 | divided_by: product.featured_image.aspect_ratio | round }}"
        >
      {%- else -%}
        {{ 'product-1' | placeholder_svg_tag: 'product__image' }}
      {%- endif -%}
    </div>

    {%- if product.images.size > 1 -%}
      <div class="product__thumbnails" role="list" aria-label="Product images">
        {%- for image in product.images limit: 5 -%}
          <button
            class="product__thumb{% if forloop.first %} is-active{% endif %}"
            type="button"
            data-thumb-src="{{ image | image_url: width: 1200 }}"
            aria-label="View image {{ forloop.index }}"
          >
            <img
              src="{{ image | image_url: width: 144 }}"
              alt="{{ image.alt | escape }}"
              width="72"
              height="72"
              loading="lazy"
            >
          </button>
        {%- endfor -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product__details">
    {%- if section.settings.badge_text != blank -%}
      <span class="product__badge">{{ section.settings.badge_text | escape }}</span>
    {%- endif -%}

    <h1 class="product__title">{{ product.title | escape }}</h1>

    <p class="product__price">
      {%- if product.compare_at_price > product.price -%}
        <s>{{ product.compare_at_price | money }}</s>
      {%- endif -%}
      <span>{{ product.price | money }}</span>
    </p>

    <div class="product__rating" aria-label="4.9 out of 5 stars">
      <span class="product__stars" aria-hidden="true">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><polygon points="7,1 8.8,5.4 13.5,5.9 10.1,9 11.1,13.7 7,11.2 2.9,13.7 3.9,9 0.5,5.9 5.2,5.4"/></svg>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><polygon points="7,1 8.8,5.4 13.5,5.9 10.1,9 11.1,13.7 7,11.2 2.9,13.7 3.9,9 0.5,5.9 5.2,5.4"/></svg>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><polygon points="7,1 8.8,5.4 13.5,5.9 10.1,9 11.1,13.7 7,11.2 2.9,13.7 3.9,9 0.5,5.9 5.2,5.4"/></svg>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><polygon points="7,1 8.8,5.4 13.5,5.9 10.1,9 11.1,13.7 7,11.2 2.9,13.7 3.9,9 0.5,5.9 5.2,5.4"/></svg>
        <svg width="14" height="14" viewBox="0 0 14 14" fill="currentColor" aria-hidden="true"><polygon points="7,1 8.8,5.4 13.5,5.9 10.1,9 11.1,13.7 7,11.2 2.9,13.7 3.9,9 0.5,5.9 5.2,5.4"/></svg>
      </span>
      <span class="product__rating-count">(Reviews)</span>
    </div>

    {%- if product.description != blank -%}
      <div class="product__description">{{ product.description }}</div>
    {%- endif -%}

    {%- if product.available -%}
      {%- assign product_form_id = 'ProductForm-' | append: section.id -%}
      {% form 'product', product, class: 'product__form', id: product_form_id %}
        {{ form.errors | default_errors }}

        {%- if product.has_only_default_variant -%}
          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
        {%- else -%}
          <input
            type="hidden"
            id="VariantInput-{{ section.id }}"
            name="id"
            value="{{ product.selected_or_first_available_variant.id }}"
          >
          <div class="product__variants">
            <span class="product__field-label">{{ 'products.variant' | t }}:</span>
            <div class="variant-pills" role="group" aria-label="{{ 'products.variant' | t }}">
              {%- for variant in product.variants -%}
                <button
                  type="button"
                  class="variant-pill{% if variant.id == product.selected_or_first_available_variant.id %} is-active{% endif %}{% unless variant.available %} is-unavailable{% endunless %}"
                  data-variant-id="{{ variant.id }}"
                  data-variant-input="#VariantInput-{{ section.id }}"
                  {% unless variant.available %}disabled{% endunless %}
                >
                  {{ variant.title | escape }}
                </button>
              {%- endfor -%}
            </div>
          </div>
        {%- endif -%}

        <div class="product__qty-row">
          <span class="product__field-label">{{ 'products.quantity' | t }}</span>
          <div class="qty-stepper" role="group" aria-label="{{ 'products.quantity' | t }}">
            <button type="button" class="qty-stepper__btn" data-qty-action="minus" aria-label="Decrease quantity">-</button>
            <span class="qty-stepper__val" aria-live="polite">1</span>
            <button type="button" class="qty-stepper__btn" data-qty-action="plus" aria-label="Increase quantity">+</button>
          </div>
          <input type="hidden" name="quantity" class="qty-stepper__input" value="1" min="1">
        </div>

        <button type="submit" class="btn btn--full">{{ 'products.add_to_cart' | t }}</button>
        <button type="submit" name="checkout" class="btn btn--secondary btn--full">Buy it now</button>
      {% endform %}
    {%- else -%}
      <button type="button" class="btn btn--full" disabled>{{ 'products.sold_out' | t }}</button>
    {%- endif -%}

    <div class="product__accordions">
      <details class="accordion">
        <summary class="accordion__header">
          <span>Details</span>
          <span class="accordion__icon" aria-hidden="true">+</span>
        </summary>
        <div class="accordion__body">
          {%- if product.description != blank -%}
            {{ product.description }}
          {%- else -%}
            <p>Full product details coming soon.</p>
          {%- endif -%}
        </div>
      </details>

      <details class="accordion">
        <summary class="accordion__header">
          <span>How to use</span>
          <span class="accordion__icon" aria-hidden="true">+</span>
        </summary>
        <div class="accordion__body">
          <p>Apply a small amount to cleansed skin morning and evening. Gently pat until absorbed. Follow with moisturizer.</p>
        </div>
      </details>

      <details class="accordion">
        <summary class="accordion__header">
          <span>Ingredients</span>
          <span class="accordion__icon" aria-hidden="true">+</span>
        </summary>
        <div class="accordion__body">
          <p>Aqua, Niacinamide, Hyaluronic Acid, Glycerin, Panthenol, Ceramide NP, Centella Asiatica Extract.</p>
        </div>
      </details>

      <details class="accordion">
        <summary class="accordion__header">
          <span>Shipping &amp; Returns</span>
          <span class="accordion__icon" aria-hidden="true">+</span>
        </summary>
        <div class="accordion__body">
          <p>Free shipping on orders over P2,500. Standard delivery 3-5 business days. Returns accepted within 30 days of purchase.</p>
        </div>
      </details>
    </div>
  </div>
</section>

{%- assign related_collection = product.collections.first -%}
{%- if related_collection != blank -%}
  <section class="product__related page-width">
    <h2 class="product__related-heading">You'll love these</h2>
    <ul class="product-grid" role="list">
      {%- for related in related_collection.products limit: 5 -%}
        {%- unless related.id == product.id -%}
          <li>{% render 'product-card', product: related %}</li>
        {%- endunless -%}
      {%- endfor -%}
    </ul>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Product",
  "enabled_on": {
    "templates": ["product"]
  },
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "placeholder": "Best Seller"
    }
  ],
  "presets": [
    {
      "name": "Product"
    }
  ]
}
{% endschema %}
