{%- liquid
  assign free_shipping_threshold = section.settings.free_shipping_threshold | default: 50 | times: 100
  assign remaining = free_shipping_threshold | minus: cart.total_price
  if remaining < 0
    assign remaining = 0
  endif
  if free_shipping_threshold > 0
    assign progress_pct = cart.total_price | times: 100.0 | divided_by: free_shipping_threshold
    if progress_pct > 100
      assign progress_pct = 100
    endif
  else
    assign progress_pct = 100
  endif
-%}

<section class="cart page-width">
  <div class="cart__title-row">
    <h1 class="cart__title">{{ 'cart.title' | t }}</h1>
    <a href="{{ routes.all_products_collection_url }}" class="cart__continue">{{ 'cart.continue_shopping' | t }}</a>
  </div>

  {%- if cart.item_count == 0 -%}
    <p class="cart__empty">{{ 'cart.empty' | t }}</p>
    <a href="{{ routes.all_products_collection_url }}" class="btn">{{ 'cart.start_shopping' | t }}</a>
  {%- else -%}
    {% form 'cart', cart, class: 'cart-form' %}
      {{ form.errors | default_errors }}

      <div class="cart__layout">
        <div class="cart__list">
          <div class="cart__header-row" aria-hidden="true">
            <span>{{ 'cart.product' | t }}</span>
            <span>{{ 'cart.quantity' | t }}</span>
            <span>{{ 'cart.price' | t }}</span>
          </div>

          <ul class="cart-items" role="list">
            {%- for item in cart.items -%}
              <li class="cart-item">
                <div class="cart-item__media">
                  {%- if item.image -%}
                    {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.image.alt, class: 'cart-item__image' }}
                  {%- else -%}
                    {%- capture cart_asset -%}
                      {%- render 'product-asset', product: item.product, class: 'cart-item__image', loading: 'lazy' -%}
                    {%- endcapture -%}
                    {%- if cart_asset != blank -%}
                      {{ cart_asset }}
                    {%- else -%}
                      {{ 'product-1' | placeholder_svg_tag: 'cart-item__image' }}
                    {%- endif -%}
                  {%- endif -%}
                </div>

                <div class="cart-item__details">
                  <h2 class="cart-item__title">
                    <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
                  </h2>
                  {%- assign item_subtitle = item.product.metafields.elora.subtitle.value -%}
                  {%- if item_subtitle != blank -%}
                    <p class="cart-item__subtitle">{{ item_subtitle | escape }}</p>
                  {%- endif -%}
                  {%- unless item.product.has_only_default_variant -%}
                    <p class="cart-item__variant">{{ item.variant.title | escape }}</p>
                  {%- endunless -%}

                  {%- unless item.properties == empty -%}
                    <dl class="cart-item__properties">
                      {%- for property in item.properties -%}
                        {%- assign property_first_char = property.first | slice: 0 -%}
                        {%- if property_first_char != '_' -%}
                          <div class="cart-item__property">
                            <dt>{{ property.first | escape }}</dt>
                            <dd>
                              {%- if property.last contains '/uploads/' -%}
                                <a href="{{ property.last }}">{{ property.last | split: '/' | last | escape }}</a>
                              {%- else -%}
                                {{ property.last | escape }}
                              {%- endif -%}
                            </dd>
                          </div>
                        {%- endif -%}
                      {%- endfor -%}
                    </dl>
                  {%- endunless -%}

                  <a href="{{ item.url_to_remove }}" class="cart-item__remove">{{ 'cart.remove' | t }}</a>
                </div>

                <div class="cart-item__qty-wrap">
                  <div class="qty-stepper" role="group" aria-label="{{ 'cart.quantity' | t }}">
                    <button type="button" class="qty-stepper__btn" data-qty-action="minus" aria-label="{{ 'products.decrease_quantity' | t }}">-</button>
                    <span class="qty-stepper__val" aria-live="polite">{{ item.quantity }}</span>
                    <button type="button" class="qty-stepper__btn" data-qty-action="plus" aria-label="{{ 'products.increase_quantity' | t }}">+</button>
                  </div>
                  <input
                    type="hidden"
                    id="Updates-{{ item.key }}"
                    name="updates[{{ item.key }}]"
                    value="{{ item.quantity }}"
                    min="0"
                    class="qty-stepper__input"
                    data-cart-quantity
                  >
                </div>

                <p class="cart-item__price">{{ item.final_line_price | money }}</p>
              </li>
            {%- endfor -%}
          </ul>
        </div>

        <aside class="cart__summary" aria-labelledby="OrderSummaryHeading-{{ section.id }}">
          <h2 class="cart__summary-title" id="OrderSummaryHeading-{{ section.id }}">{{ 'cart.order_summary' | t }}</h2>

          <div class="cart__summary-lines">
            <div class="cart__summary-line">
              <span>{{ 'cart.subtotal' | t }}</span>
              <span>{{ cart.items_subtotal_price | money }}</span>
            </div>
            <div class="cart__summary-line cart__summary-line--muted">
              <span>{{ 'cart.shipping' | t }}</span>
              <span>{{ 'cart.shipping_at_checkout' | t }}</span>
            </div>
            <div class="cart__summary-line cart__summary-line--muted">
              <span>{{ 'cart.estimated_tax' | t }}</span>
              <span>{{ 'cart.tax_placeholder' | t }}</span>
            </div>
          </div>

          <div class="cart__summary-total">
            <span>{{ 'cart.total' | t }}</span>
            <span>{{ cart.total_price | money }}</span>
          </div>

          <div class="cart__shipping-note">
            <span class="cart__shipping-icon" aria-hidden="true">{% render 'icon-truck' %}</span>
            {%- if remaining > 0 -%}
              {%- assign remaining_money = remaining | money -%}
              <p>{{ 'cart.free_shipping_remaining' | t: amount: remaining_money }}</p>
            {%- else -%}
              <p>{{ 'cart.free_shipping_unlocked' | t }}</p>
            {%- endif -%}
          </div>
          <div
            class="cart__shipping-bar"
            role="progressbar"
            aria-valuemin="0"
            aria-valuemax="100"
            aria-valuenow="{{ progress_pct | round }}"
            aria-label="{{ 'cart.free_shipping_progress' | t }}"
          >
            <span style="width: {{ progress_pct }}%"></span>
          </div>

          <button type="submit" name="checkout" class="btn btn--full cart__checkout">{{ 'cart.checkout' | t }}</button>

          {%- if additional_checkout_buttons -%}
            <div class="cart__accelerated">
              {{ content_for_additional_checkout_buttons }}
            </div>
          {%- endif -%}

          {%- if shop.enabled_payment_types.size > 0 -%}
            <div class="cart__payments">
              <p class="cart__payments-label">{{ 'cart.we_accept' | t }}</p>
              <div class="cart__payment-icons">
                {%- for type in shop.enabled_payment_types -%}
                  {{ type | payment_type_svg_tag: class: 'cart__payment-icon' }}
                {%- endfor -%}
              </div>
            </div>
          {%- endif -%}
        </aside>
      </div>
    {% endform %}
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Cart",
  "enabled_on": {
    "templates": ["cart"]
  },
  "settings": [
    {
      "type": "number",
      "id": "free_shipping_threshold",
      "label": "Free shipping threshold",
      "default": 50,
      "info": "Amount in shop currency. Progress uses this number times 100 for cents."
    }
  ],
  "presets": [
    {
      "name": "Cart"
    }
  ]
}
{% endschema %}
