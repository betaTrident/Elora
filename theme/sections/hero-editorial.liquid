<section class="hero">
  {%- assign hero_img_src = '' -%}
  {%- if section.settings.image != blank -%}
    {%- assign hero_img_src = section.settings.image | image_url: width: 2400 -%}
  {%- elsif section.settings.fallback_asset != blank -%}
    {%- assign hero_img_src = section.settings.fallback_asset | asset_url -%}
  {%- endif -%}

  {%- if hero_img_src != '' -%}
    <div class="hero__bg" aria-hidden="true">
      <img
        src="{{ hero_img_src }}"
        class="hero__bg-img"
        loading="eager"
        alt=""
        width="1001"
        height="941"
      >
    </div>
  {%- endif -%}

  <div class="hero__inner page-width">
    <div class="hero__text">
      {%- if section.settings.heading != blank -%}
        <h1 class="hero__heading reveal">{{ section.settings.heading }}</h1>
      {%- endif -%}
      {%- if section.settings.body != blank -%}
        <div class="hero__body reveal reveal-delay-1">{{ section.settings.body }}</div>
      {%- endif -%}
      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
        <a href="{{ section.settings.cta_url }}" class="btn reveal reveal-delay-2">{{ section.settings.cta_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% stylesheet %}
  .hero {
    position: relative;
    overflow: hidden;
    display: flex;
    align-items: center;
    background-color: #e6d0be;
    min-height: calc(100dvh - var(--header-stack, 6.75rem));
  }

  .hero__bg {
    position: absolute;
    inset: 0;
    z-index: 0;
  }

  .hero__bg-img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
    display: block;
  }

  .hero::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background: linear-gradient(
      90deg,
      var(--color-porcelain) 0%,
      rgba(246, 239, 232, 0.7) 26%,
      rgba(230, 208, 190, 0.18) 48%,
      transparent 64%
    );
  }

  .hero__inner {
    position: relative;
    z-index: 2;
    width: min(1120px, calc(100% - var(--spacing-lg)));
    margin-inline: auto;
    padding: var(--spacing-xl) 0;
    display: flex;
    align-items: center;
  }

  .hero__text {
    max-width: min(28rem, 46%);
    display: flex;
    flex-direction: column;
  }

  .hero__heading,
  .hero__heading p {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-weight: 400;
    font-size: clamp(2.5rem, 5vw, 4.6rem);
    line-height: 1.08;
    letter-spacing: -0.03em;
    color: var(--color-ink);
  }

  .hero__body {
    margin-top: var(--spacing-md);
    color: var(--color-muted);
    line-height: 1.68;
    font-size: 1rem;
  }

  .hero__body p { margin: 0; }

  .hero .btn {
    margin-top: var(--spacing-lg);
    align-self: flex-start;
  }

  .hero:not(:has(.hero__bg)) {
    background-color: var(--color-porcelain);
    background-image: linear-gradient(105deg, var(--color-porcelain) 30%, #EBC5AD 100%);
  }

  .hero:not(:has(.hero__bg)) .hero__text {
    max-width: 60%;
  }

  .hero:not(:has(.hero__bg))::after { display: none; }

  @media (max-width: 767px) {
    .hero {
      align-items: flex-start;
    }

    .hero__bg-img {
      object-position: center bottom;
    }

    .hero::after {
      background: linear-gradient(
        180deg,
        var(--color-porcelain) 0%,
        rgba(246, 239, 232, 0.78) 34%,
        rgba(230, 208, 190, 0.12) 58%,
        transparent 76%
      );
    }

    .hero__inner {
      padding: var(--spacing-xl) 0 46vh;
    }

    .hero__text {
      max-width: 100%;
    }

    .hero__heading,
    .hero__heading p {
      font-size: clamp(2.25rem, 10vw, 3.25rem);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Hero editorial",
  "class": "section-hero",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Elora"
    },
    {
      "type": "richtext",
      "id": "heading",
      "label": "Heading",
      "default": "<p>Your everyday beauty ritual.</p>"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA label"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA URL"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "text",
      "id": "fallback_asset",
      "label": "Fallback asset filename",
      "info": "Theme asset filename, e.g. lp-hero.png"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background",
      "default": "#F6EFE8"
    }
  ],
  "presets": [
    {
      "name": "Hero editorial"
    }
  ]
}
{% endschema %}
