{% doc %}
Renders a product card with image, title, subtitle, price, and link.
@param {product} product - The product to render
@example
{% render 'product-card', product: product %}
{% enddoc %}

{%- if product != blank -%}
  {%- assign card_subtitle = product.metafields.elora.subtitle.value -%}
  <article class="product-card">
    <a href="{{ product.url }}" class="product-card__link">
      <div class="product-card__image-wrap">
        {%- if product.featured_image -%}
          {{ product.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', alt: product.featured_image.alt, class: 'product-card__image' }}
        {%- else -%}
          {%- capture product_asset_markup -%}
            {%- render 'product-asset', product: product, class: 'product-card__image', loading: 'lazy' -%}
          {%- endcapture -%}
          {%- if product_asset_markup != blank -%}
            {{ product_asset_markup }}
          {%- else -%}
            {{ 'product-1' | placeholder_svg_tag: 'product-card__placeholder' }}
          {%- endif -%}
        {%- endif -%}
      </div>
      <div class="product-card__body">
        <h3 class="product-card__title">{{ product.title | escape }}</h3>
        {%- if card_subtitle != blank -%}
          <p class="product-card__subtitle">{{ card_subtitle | escape }}</p>
        {%- endif -%}
        <p class="product-card__price">{{ product.price | money }}</p>
      </div>
    </a>
  </article>
{%- endif -%}
