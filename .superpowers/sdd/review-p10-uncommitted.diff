+            ? fetchError
+            : new Error(String(fetchError)),
+        ),
+      )
+      .finally(() => setLoading(false))
+  }, [])
+
+  useEffect(() => {
+    fetchSettings()
+  }, [fetchSettings])
+
+  async function save() {
