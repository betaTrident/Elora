@@ -0,0 +1,163 @@
+<section class="routine-editorial">
+  <div class="routine-editorial__inner page-width">
+    {%- for block in section.blocks -%}
+      <article class="routine-editorial__step" {{ block.shopify_attributes }}>
+        <div class="routine-editorial__text">
+          {%- if block.settings.moment != blank -%}
+            <span class="routine-editorial__moment">{{ block.settings.moment | escape }}</span>
+          {%- endif -%}
+          {%- if block.settings.heading != blank -%}
+            <h3 class="routine-editorial__heading">{{ block.settings.heading | escape }}</h3>
+          {%- endif -%}
+          {%- if block.settings.body != blank -%}
+            <div class="routine-editorial__body">{{ block.settings.body }}</div>
+          {%- endif -%}
+          {%- if block.settings.product != blank -%}
+            {% render 'product-card', product: block.settings.product %}
+          {%- endif -%}
+        </div>
+        {%- if block.settings.image -%}
+          <div class="routine-editorial__image">
+            {{ block.settings.image | image_url: width: 600 | image_tag: class: 'routine-editorial__img', alt: block.settings.image.alt, loading: 'lazy' }}
+          </div>
+        {%- endif -%}
+      </article>
+    {%- endfor -%}
+  </div>
+</section>
+
+{% stylesheet %}
+  .routine-editorial {
+    padding: var(--spacing-xl) 0;
+    background: var(--color-porcelain);
+  }
+
+  .routine-editorial__inner {
+    display: grid;
+    gap: var(--spacing-xl);
+  }
+
+  .routine-editorial__step {
+    display: grid;
+    gap: var(--spacing-lg);
+    align-items: center;
+  }
+
+  @media (min-width: 768px) {
+    .routine-editorial__step:has(.routine-editorial__image) {
+      grid-template-columns: 1fr 1fr;
+    }
+
+    .routine-editorial__step:nth-child(even) .routine-editorial__image {
+      order: -1;
+    }
+  }
+
+  .routine-editorial__moment {
+    display: inline-block;
+    margin-bottom: var(--spacing-sm);
+    font-size: 0.75rem;
+    letter-spacing: 0.16em;
+    text-transform: uppercase;
+    color: var(--color-sage);
+  }
+
+  .routine-editorial__heading {
+    margin: 0 0 var(--spacing-sm);
+    font-size: clamp(1.5rem, 3vw, 2.15rem);
+    line-height: 1.2;
+  }
+
+  .routine-editorial__body {
+    margin: 0 0 var(--spacing-md);
+    color: var(--color-muted);
+    max-width: 42ch;
+  }
+
+  .routine-editorial__body p {
+    margin: 0;
+  }
+
+  .routine-editorial__img {
+    width: 100%;
+    aspect-ratio: 4 / 5;
+    object-fit: cover;
+    border-radius: var(--radius-md);
+    background: var(--color-sand);
+  }
+
+  .routine-editorial__text .product-card {
+    max-width: 16rem;
+  }
+{% endstylesheet %}
+
+{% schema %}
+{
+  "name": "Routine editorial",
+  "blocks": [
+    {
+      "type": "step",
+      "name": "Step",
+      "settings": [
+        {
+          "type": "text",
+          "id": "moment",
+          "label": "Moment",
+          "placeholder": "AM ┬╖ Face"
+        },
+        {
+          "type": "text",
+          "id": "heading",
+          "label": "Heading"
+        },
+        {
+          "type": "richtext",
+          "id": "body",
+          "label": "Body"
+        },
+        {
+          "type": "image_picker",
+          "id": "image",
+          "label": "Image"
+        },
+        {
+          "type": "product",
+          "id": "product",
+          "label": "Featured product"
+        }
+      ]
+    }
+  ],
+  "presets": [
+    {
+      "name": "Routine editorial",
+      "blocks": [
+        {
+          "type": "step",
+          "settings": {
+            "moment": "AM ┬╖ Face",
+            "heading": "Morning light",
+            "body": "<p>A quiet start. Cleanse, then a veil of moisture before the day begins.</p>"
+          }
+        },
+        {
+          "type": "step",
+          "settings": {
+            "moment": "PM ┬╖ Face",
+            "heading": "The last quiet",
+            "body": "<p>Remove the day. Soften. Leave skin ready for rest.</p>"
+          }
+        },
+        {
+          "type": "step",
+          "settings": {
+            "moment": "After shower",
+            "heading": "Skin still warm",
+            "body": "<p>Oil, mist, a lingering close scent. The body ritual.</p>"
+          }
+        }
+      ]
+    }
+  ]
+}
+{% endschema %}
