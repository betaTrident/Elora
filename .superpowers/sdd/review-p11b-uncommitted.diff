+      <h2 class="ingredient-honesty__heading">{{ section.settings.heading | escape }}</h2>
+    {%- endif -%}
+    <div class="ingredient-honesty__grid">
+      {%- for block in section.blocks -%}
+        <div
+          class="ingredient-honesty__item ingredient-honesty__item--{{ block.settings.type }}"
+          {{ block.shopify_attributes }}
+        >
+          <span class="ingredient-honesty__label">
+            {%- if block.settings.type == 'in' -%}
+              {{ 'ingredient_honesty.in' | t }}
+            {%- else -%}
+              {{ 'ingredient_honesty.never' | t }}
+            {%- endif -%}
+          </span>
+          {%- if block.settings.ingredient != blank -%}
+            <p class="ingredient-honesty__name">{{ block.settings.ingredient | escape }}</p>
+          {%- endif -%}
+          {%- if block.settings.note != blank -%}
+            <small class="ingredient-honesty__note">{{ block.settings.note | escape }}</small>
+          {%- endif -%}
+        </div>
+      {%- endfor -%}
+    </div>
+  </div>
+</section>
+
+{% stylesheet %}
+  .ingredient-honesty {
+    padding: var(--spacing-xl) 0;
+    background: var(--color-surface);
+  }
+
+  .ingredient-honesty__heading {
+    margin: 0 0 var(--spacing-lg);
+    font-size: clamp(1.6rem, 3vw, 2.4rem);
+    line-height: 1.2;
+  }
+
+  .ingredient-honesty__grid {
+    display: grid;
+    gap: var(--spacing-md);
+    grid-template-columns: 1fr;
+  }
+
+  @media (min-width: 700px) {
+    .ingredient-honesty__grid {
+      grid-template-columns: repeat(2, 1fr);
+    }
+  }
+
+  .ingredient-honesty__item {
+    display: flex;
+    flex-direction: column;
+    gap: 0.35rem;
+    padding: var(--spacing-lg);
+    border-radius: var(--radius-md);
+    border: 1px solid var(--color-sand);
+    background: var(--color-porcelain);
+  }
+
+  .ingredient-honesty__label {
+    display: inline-flex;
+    align-items: center;
+    gap: 0.45rem;
+    font-size: 0.75rem;
+    letter-spacing: 0.14em;
+    text-transform: uppercase;
+    color: var(--color-sage);
+  }
+
+  .ingredient-honesty__label::before {
+    content: "";
+    width: 0.5rem;
+    height: 0.5rem;
+    border-radius: 50%;
+    background: var(--color-sand);
+  }
+
+  .ingredient-honesty__item--in {
+    background: var(--color-surface);
+  }
+
+  .ingredient-honesty__item--in .ingredient-honesty__label {
+    color: var(--color-sage);
+  }
+
+  .ingredient-honesty__item--in .ingredient-honesty__label::before {
+    background: var(--color-sage);
+  }
+
+  .ingredient-honesty__item--never .ingredient-honesty__label {
+    color: var(--color-muted);
+  }
+
+  .ingredient-honesty__item--never .ingredient-honesty__label::before {
+    border-radius: 1px;
+    background: var(--color-sand);
+  }
+
+  .ingredient-honesty__name {
+    margin: 0;
+    font-family: var(--font-display);
+    font-size: 1.35rem;
+    font-weight: 400;
+    line-height: 1.3;
+  }
+
+  .ingredient-honesty__note {
+    color: var(--color-muted);
+    font-size: 0.9rem;
+  }
+{% endstylesheet %}
+
+{% schema %}
+{
+  "name": "Ingredient honesty",
+  "settings": [
+    {
+      "type": "text",
+      "id": "heading",
+      "label": "Heading",
+      "default": "What's in. What's never in."
