+  ],
+  "presets": [
+    {
+      "name": "Ingredient honesty",
+      "blocks": [
+        {
+          "type": "ingredient",
+          "settings": {
+            "type": "in",
+            "ingredient": "Rose otto",
+            "note": "A close, petal warmth."
+          }
+        },
+        {
+          "type": "ingredient",
+          "settings": {
+            "type": "in",
+            "ingredient": "Sandalwood",
+            "note": "Quiet wood, worn on skin."
+          }
+        },
+        {
+          "type": "ingredient",
+          "settings": {
+            "type": "never",
+            "ingredient": "Harsh fragrance",
+            "note": "Nothing that fills a room uninvited."
+          }
+        },
+        {
+          "type": "ingredient",
+          "settings": {
+            "type": "never",
+            "ingredient": "Heavy film",
+            "note": "Nothing that sits on the skin."
+          }
+        }
+      ]
+    }
+  ]
+}
+{% endschema %}
