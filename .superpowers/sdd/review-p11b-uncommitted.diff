@@ -0,0 +1,159 @@
+<section class="scent-wardrobe">
+  <div class="scent-wardrobe__inner page-width">
+    {%- if section.settings.heading != blank -%}
+      <h2 class="scent-wardrobe__heading">{{ section.settings.heading | escape }}</h2>
+    {%- endif -%}
+    <ul class="scent-wardrobe__grid" role="list">
+      {%- for block in section.blocks -%}
+        <li class="scent-wardrobe__item" {{ block.shopify_attributes }}>
+          {%- if block.settings.name != blank -%}
+            <h3 class="scent-wardrobe__name">{{ block.settings.name | escape }}</h3>
+          {%- endif -%}
+          {%- if block.settings.note != blank -%}
+            <p class="scent-wardrobe__note">{{ block.settings.note | escape }}</p>
+          {%- endif -%}
+        </li>
+      {%- endfor -%}
+    </ul>
+  </div>
+</section>
+
+{% stylesheet %}
+  .scent-wardrobe {
+    padding: var(--spacing-xl) 0;
+    background: var(--color-porcelain);
+  }
+
+  .scent-wardrobe__heading {
+    margin: 0 0 var(--spacing-lg);
+    font-size: clamp(1.6rem, 3vw, 2.4rem);
+    line-height: 1.2;
+  }
+
+  .scent-wardrobe__grid {
+    list-style: none;
+    margin: 0;
+    padding: 0;
+    display: grid;
+    gap: var(--spacing-md);
+    grid-template-columns: 1fr;
+  }
+
+  @media (min-width: 600px) {
+    .scent-wardrobe__grid {
+      grid-template-columns: repeat(2, 1fr);
+    }
+  }
+
+  @media (min-width: 900px) {
+    .scent-wardrobe__grid {
+      grid-template-columns: repeat(4, 1fr);
+    }
+  }
+
+  .scent-wardrobe__item {
+    min-height: 11rem;
+    padding: var(--spacing-lg);
+    border-radius: var(--radius-md);
+    border: 1px solid var(--color-sand);
+    background: var(--color-surface);
+    display: flex;
+    flex-direction: column;
+    justify-content: flex-end;
+    gap: 0.4rem;
+  }
+
+  .scent-wardrobe__item:nth-child(4n + 2) {
+    background: var(--color-sand);
+  }
+
+  .scent-wardrobe__item:nth-child(4n + 3) {
+    background: var(--color-surface);
+    border-color: var(--color-sage);
+  }
+
+  .scent-wardrobe__item:nth-child(4n) {
+    background: color-mix(in srgb, var(--color-sage) 18%, var(--color-porcelain));
+  }
+
+  .scent-wardrobe__name {
+    margin: 0;
+    font-family: var(--font-display);
+    font-size: 1.5rem;
+    font-weight: 400;
+    line-height: 1.2;
+  }
+
+  .scent-wardrobe__note {
+    margin: 0;
+    color: var(--color-sage);
+    font-size: 0.95rem;
+  }
+{% endstylesheet %}
+
+{% schema %}
+{
+  "name": "Scent wardrobe",
+  "settings": [
+    {
+      "type": "text",
+      "id": "heading",
+      "label": "Heading",
+      "default": "A scent wardrobe"
+    }
+  ],
+  "blocks": [
+    {
+      "type": "scent",
+      "name": "Scent",
+      "settings": [
+        {
+          "type": "text",
+          "id": "name",
+          "label": "Name"
+        },
+        {
+          "type": "text",
+          "id": "note",
+          "label": "Note"
+        }
+      ]
+    }
+  ],
+  "presets": [
+    {
+      "name": "Scent wardrobe",
+      "blocks": [
+        {
+          "type": "scent",
+          "settings": {
+            "name": "Warm",
+            "note": "Sandalwood, close to skin."
+          }
+        },
+        {
+          "type": "scent",
+          "settings": {
+            "name": "Soft",
+            "note": "Clean musk, after water."
+          }
+        },
+        {
+          "type": "scent",
+          "settings": {
+            "name": "Bloom",
+            "note": "Quiet florals, morning light."
+          }
+        },
+        {
+          "type": "scent",
+          "settings": {
+            "name": "Night",
+            "note": "Amber, low light."
+          }
+        }
+      ]
+    }
+  ]
+}
+{% endschema %}
