+<section class="hero" style="--hero-bg: {{ section.settings.bg_color }};">
+  <div class="hero__inner page-width">
+    <div class="hero__text">
+      {%- if section.settings.eyebrow != blank -%}
+        <p class="hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
+      {%- endif -%}
+      {%- if section.settings.heading != blank -%}
+        <h1 class="hero__heading">{{ section.settings.heading }}</h1>
+      {%- endif -%}
+      {%- if section.settings.body != blank -%}
+        <div class="hero__body">{{ section.settings.body }}</div>
+      {%- endif -%}
+      {%- if section.settings.cta_label != blank and section.settings.cta_url != blank -%}
+        <a href="{{ section.settings.cta_url }}" class="btn btn--primary">{{ section.settings.cta_label | escape }}</a>
+      {%- endif -%}
+    </div>
+    {%- if section.settings.image -%}
+      <div class="hero__image">
+        {{ section.settings.image | image_url: width: 900 | image_tag: loading: 'eager', class: 'hero__img', alt: section.settings.image.alt }}
+      </div>
+    {%- endif -%}
+  </div>
+</section>
+
+{% stylesheet %}
+  .hero {
+    background-color: var(--hero-bg, var(--color-porcelain));
+    padding: var(--spacing-xl) 0;
+  }
+
+  .hero__inner {
+    display: grid;
+    gap: var(--spacing-xl);
+    align-items: center;
+  }
+
+  @media (min-width: 768px) {
+    .hero__inner:has(.hero__image) {
+      grid-template-columns: 1fr 1fr;
+    }
+  }
+
+  .hero__eyebrow {
+    margin: 0 0 var(--spacing-md);
+    font-size: 0.75rem;
+    letter-spacing: 0.2em;
+    text-transform: uppercase;
+    color: var(--color-sage);
+  }
+
+  .hero__heading,
+  .hero__heading p {
+    margin: 0;
+    font-family: var(--font-display);
+    font-weight: 400;
+    font-size: clamp(2.25rem, 5.4vw, 4.15rem);
+    line-height: 1.12;
+    color: var(--color-ink);
+  }
+
+  .hero__body {
+    margin-top: var(--spacing-md);
+    max-width: 38ch;
+    color: var(--color-muted);
+  }
+
+  .hero__body p {
+    margin: 0;
+  }
+
+  .hero .btn {
+    margin-top: var(--spacing-lg);
+  }
+
+  .hero__img {
+    width: 100%;
+    aspect-ratio: 4 / 5;
+    object-fit: cover;
+    border-radius: var(--radius-md);
+    background: var(--color-sand);
+  }
+{% endstylesheet %}
+
+{% schema %}
+{
+  "name": "Hero editorial",
+  "settings": [
+    {
+      "type": "text",
+      "id": "eyebrow",
+      "label": "Eyebrow",
+      "default": "Elora"
+    },
+    {
+      "type": "richtext",
+      "id": "heading",
+      "label": "Heading",
+      "default": "<p>Your everyday beauty ritual.</p>"
+    },
+    {
+      "type": "richtext",
+      "id": "body",
+      "label": "Body"
+    },
+    {
+      "type": "text",
+      "id": "cta_label",
+      "label": "CTA label"
+    },
+    {
+      "type": "url",
+      "id": "cta_url",
+      "label": "CTA URL"
+    },
+    {
+      "type": "image_picker",
+      "id": "image",
+      "label": "Image"
+    },
+    {
+      "type": "color",
+      "id": "bg_color",
+      "label": "Background",
+      "default": "#F6EFE8"
+    }
+  ],
+  "presets": [
+    {
+      "name": "Hero editorial"
+    }
+  ]
+}
+{% endschema %}
