+  it('does not embed Shopify product GIDs', () => {
+    const serialized = JSON.stringify(SAMPLE_RITUALS)
+    expect(serialized).not.toMatch(/gid:\/\/shopify/i)
+    expect(serialized).not.toContain('shopifyProductId')
