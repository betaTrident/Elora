+  })
+})
+
+describe('SAMPLE_RITUALS', () => {
+  it('defines three named demo rituals', () => {
+    expect(SAMPLE_RITUALS).toHaveLength(3)
+    expect(SAMPLE_RITUALS.map(r => r.title)).toEqual([
+      'AM Glow Ritual',
