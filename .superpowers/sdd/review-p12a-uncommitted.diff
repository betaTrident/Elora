+    font-size: 0.875rem;
+    letter-spacing: 0.03em;
+    text-decoration: underline;
+    text-underline-offset: 0.25em;
+    cursor: pointer;
+    transition: color var(--transition-fast);
+  }
+
+  .ritual-builder__restart:hover {
+    color: var(--color-ink);
+  }
+
+  .ritual-builder__restart:focus-visible {
+    outline: 2px solid var(--color-sage);
+    outline-offset: 2px;
+  }
+{% endstylesheet %}
