+<header class="header page-width">
+  {% render 'brand-lockup' %}
+
+  <nav class="header__nav" aria-label="{{ 'header.menu' | t }}">
+    <ul>
+      {%- for link in linklists.main-menu.links -%}
+        <li>
+          <a
+            href="{{ link.url }}"
+            {% if link.current %}
+              aria-current="page"
+            {% endif %}
+          >
+            {{ link.title | escape }}
+          </a>
+        </li>
+      {%- endfor -%}
+    </ul>
+  </nav>
+
+  <a href="{{ routes.cart_url }}" class="header__cart">
+    <span>{{ 'header.cart' | t }}</span>
+    <span class="header__cart-count">({{ cart.item_count }})</span>
+  </a>
+</header>
+
+{% schema %}
+{
+  "name": "Header",
+  "class": "section-header",
+  "enabled_on": {
+    "groups": ["header"]
+  },
+  "settings": []
+}
+{% endschema %}
diff --git a/theme/sections/main-cart.liquid b/theme/sections/main-cart.liquid
new file mode 100644
index 0000000..d2e0173
--- /dev/null
+++ b/theme/sections/main-cart.liquid
@@ -0,0 +1,95 @@
+<section class="cart page-width">
+  <h1 class="cart__title">{{ 'cart.title' | t }}</h1>
+
+  {%- if cart.item_count == 0 -%}
+    <p class="cart__empty">{{ 'cart.empty' | t }}</p>
+  {%- else -%}
+    {% form 'cart', cart, class: 'cart-form' %}
+      {{ form.errors | default_errors }}
+
+      <ul class="cart-items" role="list">
+        {%- for item in cart.items -%}
+          <li class="cart-item">
+            {%- if item.image -%}
+              {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.image.alt, class: 'cart-item__image' }}
+            {%- else -%}
+              {{ 'product-1' | placeholder_svg_tag: 'cart-item__image' }}
+            {%- endif -%}
+
+            <div class="cart-item__details">
+              <h2 class="cart-item__title">
+                <a href="{{ item.url }}">{{ item.product.title | escape }}</a>
+              </h2>
+              {%- unless item.product.has_only_default_variant -%}
+                <p class="cart-item__variant">{{ item.variant.title | escape }}</p>
+              {%- endunless -%}
+
+              {%- unless item.properties == empty -%}
+                <dl class="cart-item__properties">
+                  {%- for property in item.properties -%}
+                    {%- assign property_first_char = property.first | slice: 0 -%}
+                    {%- if property_first_char != '_' -%}
+                      <div class="cart-item__property">
+                        <dt>{{ property.first | escape }}</dt>
+                        <dd>
+                          {%- if property.last contains '/uploads/' -%}
+                            <a href="{{ property.last }}">{{ property.last | split: '/' | last | escape }}</a>
+                          {%- else -%}
+                            {{ property.last | escape }}
+                          {%- endif -%}
+                        </dd>
+                      </div>
+                    {%- endif -%}
+                  {%- endfor -%}
+                </dl>
+              {%- endunless -%}
+
+              <div class="cart-item__actions">
+                <div class="field">
+                  <label for="Updates-{{ item.key }}">{{ 'cart.quantity' | t }}</label>
+                  <input
+                    type="number"
+                    id="Updates-{{ item.key }}"
+                    name="updates[{{ item.key }}]"
+                    value="{{ item.quantity }}"
+                    min="0"
+                    data-cart-quantity
+                  >
+                </div>
+                <a href="{{ item.url_to_remove }}">{{ 'cart.remove' | t }}</a>
+              </div>
+            </div>
+
+            <p class="cart-item__price">{{ item.final_line_price | money }}</p>
+          </li>
+        {%- endfor -%}
+      </ul>
+
+      <div class="cart__footer">
+        <p class="cart__subtotal">
+          {{ 'cart.subtotal' | t }}
+          {{ cart.total_price | money }}
+        </p>
+        <div class="cart__actions">
+          <button type="submit" name="update" class="btn btn--secondary">{{ 'cart.update' | t }}</button>
+          <button type="submit" name="checkout" class="btn">{{ 'cart.checkout' | t }}</button>
+        </div>
+      </div>
+    {% endform %}
+  {%- endif -%}
+</section>
+
+{% schema %}
+{
+  "name": "Cart",
+  "enabled_on": {
+    "templates": ["cart"]
+  },
+  "settings": [],
+  "presets": [
+    {
+      "name": "Cart"
+    }
+  ]
+}
+{% endschema %}
diff --git a/theme/sections/main-collection.liquid b/theme/sections/main-collection.liquid
new file mode 100644
index 0000000..cf5aa5d
--- /dev/null
+++ b/theme/sections/main-collection.liquid
@@ -0,0 +1,31 @@
+<section class="collection page-width">
+  <h1 class="collection__title">{{ collection.title | escape }}</h1>
+
+  {% paginate collection.products by 12 %}
+    {%- if collection.products.size > 0 -%}
+      <ul class="product-grid" role="list">
+        {%- for product in collection.products -%}
+          <li>{% render 'product-card', product: product %}</li>
+        {%- endfor -%}
+      </ul>
+      <div class="collection__pagination">{{ paginate | default_pagination }}</div>
+    {%- else -%}
+      <p class="collection__empty">{{ 'collections.empty' | t }}</p>
+    {%- endif -%}
+  {% endpaginate %}
+</section>
+
+{% schema %}
+{
+  "name": "Collection",
+  "enabled_on": {
+    "templates": ["collection"]
+  },
+  "settings": [],
+  "presets": [
+    {
+      "name": "Collection"
+    }
+  ]
+}
+{% endschema %}
diff --git a/theme/sections/main-product.liquid b/theme/sections/main-product.liquid
new file mode 100644
index 0000000..c3cccbc
--- /dev/null
+++ b/theme/sections/main-product.liquid
@@ -0,0 +1,82 @@
+<section class="product page-width">
+  <div class="product__media">
+    {%- if product.featured_image -%}
+      {{ product.featured_image | image_url: width: 1200 | image_tag: loading: 'eager', alt: product.featured_image.alt, class: 'product__image' }}
+    {%- else -%}
+      {{ 'product-1' | placeholder_svg_tag: 'product__image' }}
+    {%- endif -%}
+  </div>
+
+  <div class="product__details">
+    <h1 class="product__title">{{ product.title | escape }}</h1>
+    <p class="product__price">
+      {%- if product.compare_at_price > product.price -%}
+        <s>{{ product.compare_at_price | money }}</s>
+      {%- endif -%}
+      <span>{{ product.price | money }}</span>
+    </p>
+
+    {%- if product.description != blank -%}
+      <div class="product__description">{{ product.description }}</div>
+    {%- endif -%}
+
+    {%- if product.available -%}
+      {% form 'product', product, class: 'product__form' %}
+        {{ form.errors | default_errors }}
+
+        {%- if product.has_only_default_variant -%}
+          <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
+        {%- else -%}
+          <div class="field">
+            <label for="Variant-{{ section.id }}">{{ 'products.variant' | t }}</label>
+            <select name="id" id="Variant-{{ section.id }}">
+              {%- for variant in product.variants -%}
+                <option
+                  value="{{ variant.id }}"
+                  {% if variant.id == product.selected_or_first_available_variant.id %}
+                    selected
+                  {% endif %}
+                  {% unless variant.available %}
+                    disabled
+                  {% endunless %}
+                >
+                  {{ variant.title | escape }} ΓÇö {{ variant.price | money }}
+                </option>
+              {%- endfor -%}
+            </select>
+          </div>
+        {%- endif -%}
+
+        <div class="field">
+          <label for="Quantity-{{ section.id }}">{{ 'products.quantity' | t }}</label>
+          <input
+            type="number"
+            id="Quantity-{{ section.id }}"
+            name="quantity"
+            value="1"
+            min="1"
+          >
+        </div>
+
+        <button type="submit" class="btn">{{ 'products.add_to_cart' | t }}</button>
+      {% endform %}
+    {%- else -%}
+      <button type="button" class="btn" disabled>{{ 'products.sold_out' | t }}</button>
+    {%- endif -%}
+  </div>
+</section>
+
+{% schema %}
+{
+  "name": "Product",
+  "enabled_on": {
+    "templates": ["product"]
+  },
+  "settings": [],
+  "presets": [
+    {
+      "name": "Product"
+    }
+  ]
+}
+{% endschema %}
