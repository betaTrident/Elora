+{% doc %}
+Renders the Elora wordmark and tagline for header and footer.
+@example
+{% render 'brand-lockup' %}
+{% enddoc %}
+
+<a href="{{ routes.root_url }}" class="brand-lockup" aria-label="Elora ΓÇö Your everyday beauty ritual.">
+  <span class="brand-lockup__name">Elora</span>
+  <span class="brand-lockup__tagline">Your everyday beauty ritual.</span>
+</a>
+
+{% stylesheet %}
+  .brand-lockup {
+    display: inline-flex;
+    flex-direction: column;
+    gap: 0.15rem;
+    text-decoration: none;
+    color: var(--color-ink);
+  }
+
+  .brand-lockup__name {
+    font-family: var(--font-display);
+    font-size: 1.75rem;
+    letter-spacing: 0.04em;
+    line-height: 1.1;
+  }
+
+  .brand-lockup__tagline {
+    font-size: 0.75rem;
+    color: var(--color-muted);
+    letter-spacing: 0.06em;
+  }
+{% endstylesheet %}
