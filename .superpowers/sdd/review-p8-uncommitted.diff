+              value={actionFilter}
+              onChange={setActionFilter}
+            />
+          </InlineStack>
+          <IndexTable
+            resourceName={{ singular: 'event', plural: 'events' }}
+            itemCount={logs.length}
+            headings={[
+              { title: 'Action' },
+              { title: 'Entity' },
+              { title: 'Who' },
+              { title: 'When' },
+            ]}
+            selectable={false}
+          >
+            {tableRows}
+          </IndexTable>
+        </BlockStack>
+      </div>
     </PageLayout>
   )
 }
