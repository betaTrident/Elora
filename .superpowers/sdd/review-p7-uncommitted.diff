+  mockInsert.mockReturnValue({ values: valuesImpl })
+}
+
+function stubUpdate(setImpl = vi.fn().mockReturnValue({ where: vi.fn().mockResolvedValue(undefined) })) {
+  mockUpdate.mockReturnValue({ set: setImpl })
