+    font-size: 1.0625rem;
+    line-height: 1.6;
+    max-width: 44ch;
+  }
+
+  .ritual-builder__steps {
+    display: flex;
+    flex-direction: column;
+    gap: var(--spacing-lg);
+  }
+
+  .ritual-builder__step-label {
+    margin: 0 0 var(--spacing-md);
+    font-family: var(--font-display);
+    font-size: 1.125rem;
+    line-height: 1.3;
+    color: var(--color-ink);
+  }
+
+  .ritual-builder__choices {
+    display: flex;
+    flex-direction: column;
+    gap: var(--spacing-sm);
+  }
+
+  @media (min-width: 480px) {
+    .ritual-builder__choices {
+      flex-direction: row;
+      flex-wrap: wrap;
+    }
+  }
+
+  .ritual-builder__choice {
+    flex: 1 1 auto;
+    min-width: 8rem;
+    padding: var(--spacing-md) var(--spacing-lg);
+    border: 1px solid var(--color-sand);
+    border-radius: var(--radius-md);
+    background: var(--color-surface);
+    color: var(--color-ink);
+    font-family: inherit;
+    font-size: 0.9375rem;
+    letter-spacing: 0.02em;
+    text-align: center;
+    cursor: pointer;
+    transition: border-color var(--transition-base), background-color var(--transition-base), box-shadow var(--transition-base);
+  }
+
+  @media (prefers-reduced-motion: no-preference) {
+    .ritual-builder__choice:hover {
+      border-color: var(--color-sage);
+      box-shadow: var(--shadow-sm);
+    }
+  }
+
+  .ritual-builder__choice.is-selected {
+    border-color: var(--color-ink);
+    background: var(--color-sand);
+    color: var(--color-ink);
+  }
+
+  .ritual-builder__choice:focus-visible {
+    outline: 2px solid var(--color-sage);
+    outline-offset: 2px;
+  }
+
+  .ritual-builder__result:not([hidden]) {
+    display: flex;
+    flex-direction: column;
+    gap: var(--spacing-md);
+  }
+
+  .ritual-builder__result-products {
+    display: flex;
+    flex-direction: column;
+    gap: var(--spacing-md);
+  }
+
+  @media (min-width: 768px) {
+    .ritual-builder__result-products {
+      flex-direction: row;
+      gap: var(--spacing-lg);
+    }
+  }
+
+  .ritual-builder__product-card {
+    flex: 1;
+    display: flex;
+    flex-direction: column;
+    gap: var(--spacing-sm);
+    padding: var(--spacing-md);
+    border-radius: var(--radius-md);
+    background: var(--color-surface);
+    border: 1px solid var(--color-sand);
+  }
+
+  .ritual-builder__product-card img {
+    width: 100%;
+    aspect-ratio: 1;
+    object-fit: cover;
+    border-radius: var(--radius-sm);
+  }
+
+  .ritual-builder__product-card p {
+    margin: 0;
+    font-family: var(--font-display);
+    font-size: 1rem;
+    line-height: 1.3;
+    color: var(--color-ink);
+  }
+
+  .ritual-builder__product-card small {
+    color: var(--color-muted);
+    font-size: 0.875rem;
+  }
+
+  .ritual-builder__add {
+    align-self: flex-start;
+    margin-top: var(--spacing-sm);
+  }
+
+  .ritual-builder__restart {
+    align-self: flex-start;
+    padding: 0;
+    border: none;
+    background: none;
+    color: var(--color-muted);
+    font-family: inherit;
+    font-size: 0.875rem;
+    letter-spacing: 0.03em;
+    text-decoration: underline;
+    text-underline-offset: 0.25em;
+    cursor: pointer;
+    transition: color var(--transition-fast);
+  }
+
+  .ritual-builder__restart:hover {
+    color: var(--color-ink);
+  }
+
+  .ritual-builder__restart:focus-visible {
+    outline: 2px solid var(--color-sage);
+    outline-offset: 2px;
+  }
+{% endstylesheet %}
